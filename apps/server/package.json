{
    "name": "purrivacy-api",
    "version": "1.0.3",
    "main": "lib/server.js",
    "scripts": {
        "start": "node --enable-source-maps lib/server.js",
        "dev": "nodemon --exec ts-node src/server.ts",
        "build": "npm run test:all && npm run build:unchecked",
        "build:unchecked": "rm -rf lib && tsc",
        "build:watch": "tsc --watch",
        "typecheck": "tsc --noEmit",
        "test": "jest",
        "test:coverage": "jest --coverage",
        "test:docker:local": "bash scripts/test-local-docker.sh",
        "test:integration": "firebase emulators:exec --project demo-purrivacy-e2e --only auth,firestore,database \"jest -c jest.emulator.config.cjs --runInBand\"",
        "test:all": "npm test && npm run test:integration",
        "verify": "npm run typecheck && npm test",
        "build:shared": "npm install --no-audit --no-fund --prefix ../../packages/shared && npm run build --prefix ../../packages/shared",
        "prebuild": "npm run build:shared",
        "prebuild:unchecked": "npm run build:shared",
        "predev": "npm run build:shared",
        "prestart": "npm run build:shared",
        "pretypecheck": "npm run build:shared",
        "pretest": "npm run build:shared",
        "pretest:coverage": "npm run build:shared",
        "pretest:integration": "npm run build:shared",
        "docker:up": "docker compose --env-file .env.local -f docker-compose.yml -f docker-compose.dev.yml up -d --build --wait",
        "docker:down": "docker compose --env-file .env.local -f docker-compose.yml -f docker-compose.dev.yml down"
    },
    "dependencies": {
        "@sentry/node": "^10.53.1",
        "dotenv": "^16.4.7",
        "expo-server-sdk": "^3.14.0",
        "express": "^4.21.2",
        "firebase-admin": "^13.10.0",
        "ioredis": "^6.0.0",
        "otpauth": "^9.4.1",
        "@purrivacy/shared": "file:../../packages/shared"
    },
    "overrides": {
        "@hono/node-server": "^2.0.5",
        "@opentelemetry/core": "^2.8.0",
        "gaxios": {
            "uuid": "11.1.1"
        },
        "google-gax": {
            "uuid": "11.1.1"
        },
        "teeny-request": {
            "uuid": "11.1.1"
        }
    },
    "devDependencies": {
        "@types/express": "^4.17.25",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.18.13",
        "firebase-tools": "^15.24.0",
        "jest": "^29.7.0",
        "nodemon": "^3.1.14",
        "ts-jest": "^29.4.11",
        "ts-node": "^10.9.1",
        "typescript": "^5.8.2"
    }
}
