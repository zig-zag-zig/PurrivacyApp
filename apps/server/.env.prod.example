# Copy to .env.prod on the VPS for purrivacy-api.chi-chi.vip.

COMPOSE_PROJECT_NAME=purrivacy
PURRIVACY_ENV_FILE=.env.prod
PURRIVACY_IMAGE=purrivacy:prod
PURRIVACY_SECRETS_DIR=./secrets/prod
PURRIVACY_HOST_BIND_ADDRESS=127.0.0.1
PURRIVACY_HOST_PORT=3002
PURRIVACY_LOG_MAX_SIZE=2m
PURRIVACY_LOG_MAX_FILE=30
PURRIVACY_LOG_COMPRESS=true
PURRIVACY_MEMORY_LIMIT=256m
PURRIVACY_MEMORY_SWAP_LIMIT=384m
PURRIVACY_MEMORY_RESERVATION=64m
PURRIVACY_CPUS=0.5
PURRIVACY_PIDS_LIMIT=128
PURRIVACY_NODE_OPTIONS=--max-old-space-size=128

PORT=3002
APP_ENV=production
NODE_ENV=production
LOG_LEVEL=info
# Single tunnel in front (app bound to loopback, tunnel on localhost): trust only loopback.
TRUST_PROXY=loopback
ALLOWED_ORIGINS=

# Rate limiting
# RATE_LIMIT_STORE=memory|redis (default: memory). Use redis before running multiple replicas.
# With RATE_LIMIT_STORE=redis, set REDIS_URL and RATE_LIMIT_FAIL_CLOSED (default: true in production).
# REDIS_URL password must be percent-encoded if it contains URL-special characters (@ -> %40, + -> %2B).
# To reuse another stack's Redis on the same VPS via an external Docker network
# (e.g. Pawify's), also set PURRIVACY_SHARED_REDIS_NETWORK (see DEPLOYMENT.md);
# the deploy script attaches the network and verifies connectivity for you.
# Critical limiters reject requests (503) when a configured shared store is unavailable and fail-closed is on.
RATE_LIMIT_STORE=memory
REDIS_URL=
RATE_LIMIT_FAIL_CLOSED=true
AUTH_EMAIL_DOMAIN=purr.ivacy
GOOGLE_APPLICATION_CREDENTIALS=/var/purrivacy/secrets/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_DATABASE_URL=
# Required, exactly 64 hex characters (generate with `openssl rand -hex 32`).
# Strictly enforced in production: a short or non-hex value fails startup.
MFA_KEK=replace-with-openssl-rand-hex-32
# REQUIRED in production: exactly 64 hex characters, distinct from MFA_KEK
# and from each other (rejecting equality prevents key-derivation reuse).
RECOVERY_ENUMERATION_PEPPER=
RECOVERY_VERIFIER_PEPPER=
# JSON body limit, capped at 15mb in production (2mb for forms).
REQUEST_JSON_LIMIT=10mb
REQUEST_FORM_LIMIT=1mb
# Per-user encrypted key record quota (1..5000, default 1000). Enforced atomically on every add.
USER_MAX_KEY_RECORDS=1000

# Error monitoring
# Use the same Sentry project for all environments and filter by environment.
SENTRY_DSN=
SENTRY_ENABLED=true
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
