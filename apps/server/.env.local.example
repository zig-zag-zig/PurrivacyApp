# Copy to .env.local for local Docker runs.

COMPOSE_PROJECT_NAME=purrivacy-local
PURRIVACY_ENV_FILE=.env.local
PURRIVACY_IMAGE=purrivacy:local
PURRIVACY_SECRETS_DIR=./secrets/local
PURRIVACY_HOST_BIND_ADDRESS=127.0.0.1
PURRIVACY_HOST_PORT=3002
PURRIVACY_LOG_MAX_SIZE=2m
PURRIVACY_LOG_MAX_FILE=30
PURRIVACY_LOG_COMPRESS=true
PURRIVACY_MEMORY_LIMIT=256m
PURRIVACY_MEMORY_SWAP_LIMIT=384m
PURRIVACY_MEMORY_RESERVATION=64m
PURRIVACY_CPUS=0.5
PURRIVACY_PIDS_LIMIT=128
PURRIVACY_NODE_OPTIONS=--max-old-space-size=128

PORT=3002
APP_ENV=local
NODE_ENV=development
LOG_LEVEL=debug
# Required in production. Local dev: 'false' or 'loopback' are both fine.
TRUST_PROXY=false
ALLOWED_ORIGINS=

# Rate limiting
# RATE_LIMIT_STORE=memory|redis (default: memory)
# With RATE_LIMIT_STORE=redis, set REDIS_URL and RATE_LIMIT_FAIL_CLOSED (default: true in production).
# Critical limiters reject requests (503) when a configured shared store is unavailable and fail-closed is on.
RATE_LIMIT_STORE=memory
REDIS_URL=
RATE_LIMIT_FAIL_CLOSED=false
AUTH_EMAIL_DOMAIN=purr.ivacy
GOOGLE_APPLICATION_CREDENTIALS=/var/purrivacy/secrets/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_DATABASE_URL=
# Required, exactly 64 hex characters (generate with `openssl rand -hex 32`).
# Strictly enforced in production.
MFA_KEK=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Required in production: 64 hex chars, distinct from MFA_KEK and from each other.
# Outside production, unset values are replaced by derived development values.
RECOVERY_ENUMERATION_PEPPER=
RECOVERY_VERIFIER_PEPPER=
# JSON body limit; capped at 15mb (2mb for forms) in production.
REQUEST_JSON_LIMIT=10mb
REQUEST_FORM_LIMIT=1mb
# Per-user encrypted key record quota (1..5000, default 1000). Enforced atomically on every add.
USER_MAX_KEY_RECORDS=1000

SENTRY_DSN=
SENTRY_ENABLED=false
SENTRY_ENVIRONMENT=local
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
